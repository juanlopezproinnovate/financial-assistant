# ── WhatsApp / YCloud ──────────────────────────────────────────
YCLOUD_API_KEY=your_ycloud_api_key_here
YCLOUD_WEBHOOK_TOKEN=your_secret_token_here   # token que tú inventas para verificar que el webhook viene de YCloud
YCLOUD_PHONE=+51912345678                     # tu número de negocio registrado en YCloud (formato E.164)

# ── Google Gemini ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq (Whisper) ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Base de datos (Supabase) ─────────────────────────────────────
# Formato: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── Zona horaria ─────────────────────────────────────────────────
TZ=America/Lima
